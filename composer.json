{
    "name": "efureev/laravel-trees",
    "description": "Multi-Tree structures for Laravel",
    "license": "MIT",
    "keywords": [
        "php",
        "tree",
        "multi-tree",
        "laravel",
        "package"
    ],
    "authors": [
        {
            "name": "Eugene Fureev",
            "email": "fureev@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "efureev/support": "^5.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.52",
        "fakerphp/faker": "^1.23",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.0",
        "squizlabs/php_codesniffer": "^3.11 || ^4.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fureev\\Trees\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fureev\\Trees\\Tests\\": "tests/",
            "Fureev\\Trees\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "sort-packages": true
    },
    "scripts": {
        "cs-fix": "@php ./vendor/bin/phpcbf",
        "phpcs": "@php ./vendor/bin/phpcs",
        "phpstan": "@php ./vendor/bin/phpstan analyze -c phpstan.neon --no-progress --ansi",
        "phpunit": "@php ./vendor/bin/phpunit --no-coverage --testdox --colors=always",
        "phpunit-cover": "@php ./vendor/bin/phpunit --coverage-clover ./storage/coverage/clover.xml",
        "test": "@phpunit",
        "test-cover": "@phpunit-cover",
        "test:docker": "docker compose up --build --abort-on-container-exit --exit-code-from app"
    }
}
